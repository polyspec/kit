{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cargo audit --json",
  "description": "The output of `cargo audit --json` in the fields that the review reads (scripts/kit/dependency-review.mts, K158).",
  "type": "object",
  "properties": {
    "vulnerabilities": {
      "type": "object",
      "properties": {
        "list": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "package": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "version"
                ]
              },
              "advisory": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string"
                  },
                  "cvss": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "title": {
                    "type": "string"
                  },
                  "url": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "id",
                  "title"
                ]
              }
            },
            "required": [
              "package",
              "advisory"
            ]
          }
        }
      }
    },
    "warnings": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "package": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "version"
              ]
            },
            "advisory": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "url": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "id",
                    "title"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "package"
          ]
        }
      }
    }
  }
}
