{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PyPI release JSON",
  "description": "The JSON of https://pypi.org/pypi/<name>/<version>/json in the fields that the review reads (scripts/kit/dependency-review.mts, K158).",
  "type": "object",
  "properties": {
    "vulnerabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "link": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ]
      }
    }
  }
}
