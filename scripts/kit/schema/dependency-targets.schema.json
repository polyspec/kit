{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dependency-targets.json (K435)",
  "type": "object",
  "required": ["schema", "snapshot", "targets"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "integer",
      "const": 1
    },
    "snapshot": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}T"
    },
    "targets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "npm": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "composer": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "pypi": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
        "go": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
