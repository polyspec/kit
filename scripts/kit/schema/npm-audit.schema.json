{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "npm audit --json",
  "description": "The output of `npm audit --json --package-lock-only` in the fields that the review reads (scripts/kit/dependency-review.mts, K158).",
  "type": "object",
  "required": ["vulnerabilities"],
  "not": { "required": ["error"], "properties": { "error": {} } },
  "properties": {
    "vulnerabilities": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "nodes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "range": {
            "type": "string"
          },
          "via": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "object",
                  "properties": {
                    "severity": {
                      "type": "string"
                    },
                    "source": {
                      "type": "number"
                    },
                    "url": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "severity",
                    "url",
                    "title"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "range"
        ]
      }
    }
  }
}
