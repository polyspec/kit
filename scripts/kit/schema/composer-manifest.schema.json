{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "composer.json",
  "description": "The fields of a Composer manifest that the tools of kit read (K158); every other field is free.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "require": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "require-dev": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "autoload": {
      "type": "object",
      "description": "The files that lint-php checks as autoload files (K377).",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "package": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "platform": {
          "description": "Each platform package with the version that Composer resolves for it, or false to leave it out.",
          "type": "object",
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "boolean"
              }
            ]
          }
        }
      }
    }
  }
}
