{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "var/full-run.json",
  "description": "The record of the last full run of a checkout, which scripts/kit/full-run.mts writes and reads back (K158): its tree, commit and keys, the holder process, the result and the record of each target and rerun.",
  "type": "object",
  "required": [
    "tree",
    "commit",
    "result",
    "pid",
    "started",
    "ended",
    "targets",
    "reruns"
  ],
  "properties": {
    "tree": {
      "type": "string"
    },
    "commit": {
      "type": "string"
    },
    "keys": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "result": {
      "type": "string"
    },
    "pid": {
      "type": "integer"
    },
    "processStart": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "started": {
      "type": "string"
    },
    "ended": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "started": {
            "type": "string"
          },
          "ended": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "elapsedMs": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "lastLines": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "reruns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "started",
          "ended",
          "targets",
          "result"
        ],
        "properties": {
          "started": {
            "type": "string"
          },
          "ended": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result": {
            "type": "string"
          }
        }
      }
    },
    "failed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
