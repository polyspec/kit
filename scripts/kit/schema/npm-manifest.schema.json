{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "package.json",
  "description": "The fields of an npm manifest that the tools of kit read (scripts/kit/schema-validate.mts readConfig, K158); a field that a tool checks itself, such as engines, is any JSON, and every other field is free.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "workspaces": {
      "description": "npm reads a list of paths and globs.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scripts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "dependencies": {
      "$ref": "#/$defs/specs"
    },
    "devDependencies": {
      "$ref": "#/$defs/specs"
    },
    "optionalDependencies": {
      "$ref": "#/$defs/specs"
    },
    "peerDependencies": {
      "$ref": "#/$defs/specs"
    },
    "overrides": {
      "type": "object"
    },
    "engines": {
      "type": "object"
    },
    "kit": {
      "type": "object",
      "properties": {
        "copies": {
          "$ref": "#/$defs/specs"
        },
        "comment": {
          "type": "string"
        },
        "owners": {
          "description": "K410-1: the owner rules that kit ships with its copies, which a consumer reads as its own owner-checks.json rules",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["paths"],
            "properties": {
              "paths": { "type": "array", "items": { "type": "string" } },
              "targets": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "private": {
      "type": "boolean"
    },
    "license": {
      "type": "string"
    },
    "packageManager": {
      "type": "string"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bin": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/specs"
        }
      ]
    }
  },
  "$defs": {
    "specs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
