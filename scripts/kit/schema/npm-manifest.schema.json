{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "package.json",
  "description": "The fields of an npm manifest that the tools of kit read (scripts/kit/schema-validate.mts readConfig, K158); a field that a tool checks itself, such as engines, is any JSON, and every other field is free.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "workspaces": {
      "description": "npm reads a list of paths and globs.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scripts": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "dependencies": {
      "$ref": "#/$defs/specs"
    },
    "devDependencies": {
      "$ref": "#/$defs/specs"
    },
    "optionalDependencies": {
      "$ref": "#/$defs/specs"
    },
    "peerDependencies": {
      "$ref": "#/$defs/specs"
    },
    "overrides": {
      "type": "object"
    },
    "engines": {
      "type": "object"
    },
    "kit": {
      "type": "object",
      "properties": {
        "copies": {
          "$ref": "#/$defs/specs"
        },
        "comment": {
          "type": "string"
        }
      }
    },
    "private": {
      "type": "boolean"
    },
    "license": {
      "type": "string"
    },
    "devEngines": {
      "type": "object",
      "properties": {
        "packageManager": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "version": { "type": "string" },
            "onFail": { "type": "string" }
          }
        }
      }
    },
    "files": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "bin": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/specs"
        }
      ]
    },
    "napi": {
      "description": "The configuration of the napi CLI that the release of an npm-native package reads (K1189): the name of the addon file and the Rust triples of its platforms.",
      "type": "object",
      "properties": {
        "binaryName": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "os": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cpu": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "main": {
      "type": "string"
    }
  },
  "$defs": {
    "specs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
