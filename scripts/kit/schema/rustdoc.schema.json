{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rustdoc JSON",
  "description": "The JSON of `cargo rustdoc -- --output-format json` in the fields that scripts/kit/parity-symbols.mts reads (K158): the id of the root item and each item of the index with its name, visibility (a string, or an object for a restricted one) and its inner item by kind: a use names its target, and a module and an impl list their items.",
  "type": "object",
  "required": [
    "root",
    "index"
  ],
  "properties": {
    "root": {
      "type": "integer"
    },
    "index": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "name",
          "visibility",
          "inner"
        ],
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "visibility": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "object"
              }
            ]
          },
          "inner": {
            "type": "object",
            "additionalProperties": {
              "type": "object"
            },
            "properties": {
              "use": {
                "type": "object",
                "required": [
                  "name",
                  "id",
                  "is_glob"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "id": {
                    "anyOf": [
                      {
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "is_glob": {
                    "type": "boolean"
                  }
                }
              },
              "module": {
                "type": "object",
                "required": [
                  "items"
                ],
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              },
              "impl": {
                "type": "object",
                "required": [
                  "items"
                ],
                "properties": {
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
