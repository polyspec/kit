{
  "name": "@polyspec/kit",
  "version": "0.0.54",
  "description": "The shared tools of the polyspec repositories",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./tracked-files": {
      "types": "./dist/tracked-files.d.mts",
      "default": "./dist/tracked-files.mjs"
    },
    "./test-hooks": {
      "types": "./dist/test-hooks.d.mts",
      "default": "./dist/test-hooks.mjs"
    },
    "./test-progress": {
      "types": "./dist/test-progress.d.mts",
      "default": "./dist/test-progress.mjs"
    },
    "./test-output": {
      "types": "./dist/test-output.d.mts",
      "default": "./dist/test-output.mjs"
    },
    "./run-tests": {
      "types": "./dist/run-tests.d.mts",
      "default": "./dist/run-tests.mjs"
    },
    "./holder-lock": {
      "types": "./dist/holder-lock.d.mts",
      "default": "./dist/holder-lock.mjs"
    },
    "./run-command": {
      "types": "./dist/run-command.d.mts",
      "default": "./dist/run-command.mjs"
    },
    "./install-vscode": {
      "types": "./dist/install-vscode.d.mts",
      "default": "./dist/install-vscode.mjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "scripts/kit/kit-bootstrap.mk",
    "scripts/kit/bootstrap/",
    "scripts/kit/catch-check-rust/Cargo.toml",
    "scripts/kit/catch-check-rust/Cargo.lock",
    "scripts/kit/catch-check-rust/src/",
    "config/layout.kit.yml",
    "config/commit-identity.json",
    "ruff.toml",
    "phpcs.xml.dist",
    "phpstan.dist.neon",
    ".golangci.yml",
    "clippy.toml",
    ".oxlintrc.json",
    "knip.json",
    ".editorconfig",
    "config/api-extractor.kit.json",
    "config/pyproject.schema.json",
    "config/composer.schema.json",
    "config/cargo.schema.json",
    "config/php-lint/composer.json",
    "config/php-lint/composer.lock",
    "workflows/release.yml",
    "workflows/gates.yml",
    "claude/settings.json",
    "PRINCIPLES.md",
    "PRINCIPLES.ko.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polyspec/kit.git"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "build": "make kit-build",
    "prepack": "make kit-build"
  },
  "packageManager": "npm@12.2.0+sha512.66c2632a94e796649738b2d7894d710c2cc2e1696893823066687f6b0d8a52e5f2b54eeaeaa32ffdc513ecca1e49ff794a5c2ec3f9515d879f1b3182b291cf35",
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/picomatch": "4.0.3",
    "@types/semver": "7.8.0",
    "@vscode/test-electron": "3.1.0",
    "typescript": "7.0.2"
  },
  "kit": {
    "copies": {
      "scripts/kit/kit-bootstrap.mk": "scripts/kit/kit-bootstrap.mk",
      "scripts/kit/bootstrap/bootstrap.mts": "scripts/kit/bootstrap/bootstrap.mts",
      "scripts/kit/bootstrap/digest.mts": "scripts/kit/bootstrap/digest.mts",
      "scripts/kit/bootstrap/files.mts": "scripts/kit/bootstrap/files.mts",
      "scripts/kit/bootstrap/install-mise.mts": "scripts/kit/bootstrap/install-mise.mts",
      "scripts/kit/bootstrap/install-npm.mts": "scripts/kit/bootstrap/install-npm.mts",
      "scripts/kit/bootstrap/install-tool.mts": "scripts/kit/bootstrap/install-tool.mts",
      "scripts/kit/bootstrap/tool-wrappers.mts": "scripts/kit/bootstrap/tool-wrappers.mts",
      "scripts/kit/bootstrap/toolchain-declared.mts": "scripts/kit/bootstrap/toolchain-declared.mts",
      ".github/workflows/release.yml": "workflows/release.yml",
      ".claude/settings.json": "claude/settings.json",
      "PRINCIPLES.md": "PRINCIPLES.md",
      "PRINCIPLES.ko.md": "PRINCIPLES.ko.md",
      "config/layout.kit.yml": "config/layout.kit.yml",
      "config/commit-identity.json": "config/commit-identity.json",
      ".editorconfig": ".editorconfig",
      "config/pyproject.schema.json": "config/pyproject.schema.json",
      "config/composer.schema.json": "config/composer.schema.json",
      "config/cargo.schema.json": "config/cargo.schema.json",
      "config/php-lint/composer.json": "config/php-lint/composer.json",
      "config/php-lint/composer.lock": "config/php-lint/composer.lock",
      ".github/workflows/gates.yml": "workflows/gates.yml"
    },
    "comment": "K410-1: the owner rules that kit ships with its copies and with the hooks that make hooks writes; a consumer merges them into its owner checks (owner-check reads them from the installed package), and the test of tests/kit/kit-sync.test.mts fails a copy that no rule owns.",
    "owners": [
      {
        "paths": [
          "scripts/kit/kit-bootstrap.mk",
          "scripts/kit/bootstrap/*.mts",
          ".github/workflows/release.yml",
          ".github/workflows/gates.yml",
          ".claude/settings.json",
          "PRINCIPLES.ko.md",
          ".editorconfig"
        ],
        "targets": [
          "kit-check"
        ]
      },
      {
        "paths": [
          "PRINCIPLES.md"
        ],
        "targets": [
          "rules-check",
          "kit-check"
        ]
      },
      {
        "paths": [
          "config/layout.kit.yml",
          "config/pyproject.schema.json",
          "config/composer.schema.json",
          "config/cargo.schema.json"
        ],
        "targets": [
          "layout-check",
          "kit-check"
        ]
      },
      {
        "paths": [
          "config/commit-identity.json"
        ],
        "targets": [
          "commits-check",
          "kit-check"
        ]
      },
      {
        "paths": [
          "config/php-lint/composer.json",
          "config/php-lint/composer.lock"
        ],
        "targets": [
          "lint-php",
          "kit-check"
        ]
      },
      {
        "paths": [
          ".githooks/pre-commit",
          ".githooks/pre-merge-commit",
          ".githooks/pre-push",
          ".githooks/commit-msg",
          ".githooks/prepare-commit-msg",
          ".githooks/reference-transaction"
        ],
        "targets": [
          "hooks-check"
        ]
      }
    ]
  },
  "dependencies": {
    "@decimalturn/toml-patch": "3.3.1",
    "@mdit-vue/shared": "3.0.2",
    "@microsoft/api-extractor": "7.59.4",
    "@microsoft/api-extractor-model": "7.33.15",
    "@renovatebot/pep440": "5.0.1",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "ajv": "8.20.0",
    "amaro": "1.2.1",
    "eslint-scope": "9.1.2",
    "github-slugger": "2.0.0",
    "jscpd": "5.4.1",
    "knip": "6.42.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "oxc-parser": "0.154.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "picomatch": "4.0.7",
    "pip-requirements-js": "1.0.3",
    "semver": "7.8.5",
    "shell-quote": "1.12.0",
    "smol-toml": "1.9.1",
    "unist-util-visit": "5.1.0"
  },
  "peerDependencies": {
    "@vscode/test-electron": "^3.1.0"
  },
  "peerDependenciesMeta": {
    "@vscode/test-electron": {
      "optional": true
    }
  }
}
