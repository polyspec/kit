{
  "name": "@polyspec/kit",
  "version": "0.0.107",
  "description": "The shared tools of the polyspec repositories",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./link": "./scripts/kit/link.mts",
    "./tracked-files": "./scripts/kit/tracked-files.mts",
    "./test-hooks": "./scripts/kit/test-hooks.mts",
    "./test-progress": "./scripts/kit/test-progress.mts",
    "./test-output": "./scripts/kit/test-output.mts",
    "./run-tests": "./scripts/kit/run-tests.mts",
    "./glob": "./scripts/kit/glob.mts",
    "./land": "./scripts/kit/land.mts",
    "./checklist": "./scripts/kit/checklist.mts",
    "./php-extension": "./scripts/kit/php-extension.mts",
    "./holder-lock": "./scripts/kit/holder-lock.mts",
    "./run-command": "./scripts/kit/run-command.mts",
    "./install-vscode": "./scripts/kit/install-vscode.mts",
    "./link-folders": "./scripts/kit/link-folders.mts",
    "./check-commits": "./scripts/kit/check-commits.mts",
    "./ci-targets": "./scripts/kit/ci-targets.mts",
    "./config/api-extractor.kit.json": "./config/api-extractor.kit.json",
    "./ruff.toml": "./ruff.toml",
    "./phpcs.xml.dist": "./phpcs.xml.dist",
    "./phpstan.dist.neon": "./phpstan.dist.neon",
    "./.golangci.yml": "./.golangci.yml",
    "./clippy.toml": "./clippy.toml",
    "./.oxlintrc.json": "./.oxlintrc.json",
    "./knip.json": "./knip.json",
    "./.editorconfig": "./.editorconfig",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "scripts/kit/bootstrap/",
    "config/layout.kit.yml",
    ".editorconfig",
    "config/api-extractor.kit.json",
    "config/composer.schema.json",
    "config/php-lint/composer.json",
    "config/php-lint/composer.lock",
    "workflows/release.yml",
    "workflows/ci-pipeline.yml",
    "actions/kit-bootstrap/action.yml",
    "PRINCIPLES.md",
    "PRINCIPLES.ko.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polyspec/kit.git"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "build": "make kit-build",
    "prepack": "make kit-build NODE=\"$npm_node_execpath\" && node scripts/kit/pack-manifest.mts",
    "postpack": "git checkout -- package.json"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "error"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vscode/test-electron": "3.1.0",
    "typescript": "7.0.2"
  },
  "kit": {
    "providerTests": [
      {
        "id": "go-workspace-runner",
        "path": "tests/kit/runtime-targets.test.mts",
        "name": "the Go workspace is the source of truth for every standard module test and build (K739)"
      },
      {
        "id": "infrastructure-test-runner",
        "path": "tests/kit/runtime-targets.test.mts",
        "name": "the infrastructure target discovers every tracked Node test and rejects an empty inventory (K739)"
      },
      {
        "id": "case-sensitive-resource-cleanup",
        "path": "tests/kit/runtime-targets.test.mts",
        "name": "a failed disk-image detach retains its resources and preserves the action failure (K739)"
      },
      {
        "id": "case-sensitive-resource-provisioning",
        "path": "tests/kit/runtime-targets.test.mts",
        "name": "case-sensitive directory uses the platform provisioner and restores the named environment"
      }
    ]
  },
  "dependencies": {
    "@mdit-vue/shared": "3.0.2",
    "@microsoft/api-extractor": "7.60.0",
    "@types/cross-spawn": "6.0.6",
    "@types/picomatch": "4.0.3",
    "@types/semver": "7.8.0",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "ajv": "8.20.0",
    "amaro": "1.3.0",
    "cross-spawn": "7.0.6",
    "github-slugger": "2.0.0",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "oxc-parser": "0.156.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "picomatch": "4.0.7",
    "semver": "7.8.5",
    "shell-quote": "1.12.0",
    "smol-toml": "1.9.1",
    "unist-util-visit": "5.2.0",
    "yaml": "2.9.1"
  },
  "peerDependencies": {
    "@playwright/test": "1.64.1",
    "@vscode/test-electron": "^3.1.0"
  },
  "peerDependenciesMeta": {
    "@vscode/test-electron": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  }
}
