{
  "name": "@polyspec/kit",
  "version": "0.0.63",
  "description": "The shared tools of the polyspec repositories",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./link": "./scripts/kit/link.mts",
    "./tracked-files": "./scripts/kit/tracked-files.mts",
    "./test-hooks": "./scripts/kit/test-hooks.mts",
    "./test-progress": "./scripts/kit/test-progress.mts",
    "./test-output": "./scripts/kit/test-output.mts",
    "./run-tests": "./scripts/kit/run-tests.mts",
    "./glob": "./scripts/kit/glob.mts",
    "./parity-declaration": "./scripts/kit/parity-declaration.mts",
    "./land": "./scripts/kit/land.mts",
    "./parity": "./scripts/kit/parity.mts",
    "./checklist": "./scripts/kit/checklist.mts",
    "./php-extension": "./scripts/kit/php-extension.mts",
    "./holder-lock": "./scripts/kit/holder-lock.mts",
    "./run-command": "./scripts/kit/run-command.mts",
    "./install-vscode": "./scripts/kit/install-vscode.mts",
    "./link-folders": "./scripts/kit/link-folders.mts",
    "./package.json": "./package.json"
  },
  "bin": {
    "polyspec-kit-hook": "./scripts/kit/claude-hook.mts"
  },
  "files": [
    "dist/",
    "scripts/kit/kit-bootstrap.mk",
    "scripts/kit/bootstrap/",
    "scripts/kit/catch-check-rust/Cargo.toml",
    "scripts/kit/catch-check-rust/Cargo.lock",
    "scripts/kit/catch-check-rust/src/",
    "config/layout.kit.yml",
    "config/commit-identity.json",
    "ruff.toml",
    "phpcs.xml.dist",
    "phpstan.dist.neon",
    ".golangci.yml",
    "clippy.toml",
    ".oxlintrc.json",
    "knip.json",
    ".editorconfig",
    "config/api-extractor.kit.json",
    "config/pyproject.schema.json",
    "config/composer.schema.json",
    "config/cargo.schema.json",
    "config/php-lint/composer.json",
    "config/php-lint/composer.lock",
    "workflows/release.yml",
    "workflows/gates.yml",
    "claude/settings.json",
    "PRINCIPLES.md",
    "PRINCIPLES.ko.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polyspec/kit.git"
  },
  "engines": {
    "node": ">=26.12.0"
  },
  "scripts": {
    "build": "make kit-build",
    "prepack": "make kit-build && node scripts/kit/pack-manifest.mts",
    "postpack": "git checkout -- package.json scripts/kit/kit-bootstrap.mk claude/settings.json"
  },
  "packageManager": "npm@12.2.0+sha512.66c2632a94e796649738b2d7894d710c2cc2e1696893823066687f6b0d8a52e5f2b54eeaeaa32ffdc513ecca1e49ff794a5c2ec3f9515d879f1b3182b291cf35",
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "@vscode/test-electron": "3.1.0",
    "typescript": "7.0.2"
  },
  "kit": {
    "providerTests": [
      {
        "id": "go-workspace-runner",
        "path": "tests/kit/runtime-targets.test.mts",
        "name": "the Go workspace is the source of truth for every standard module test and build (K739)"
      },
      {
        "id": "infrastructure-test-runner",
        "path": "tests/kit/runtime-targets.test.mts",
        "name": "the infrastructure target discovers every tracked Node test and rejects an empty inventory (K739)"
      },
      {
        "id": "case-sensitive-resource-cleanup",
        "path": "tests/kit/runtime-targets.test.mts",
        "name": "a failed disk-image detach retains its resources and preserves the action failure (K739)"
      },
      {
        "id": "case-sensitive-resource-provisioning",
        "path": "tests/kit/runtime-targets.test.mts",
        "name": "case-sensitive directory uses the platform provisioner and restores the named environment"
      }
    ],
    "copies": {
      "PRINCIPLES.md": "PRINCIPLES.md",
      "PRINCIPLES.ko.md": "PRINCIPLES.ko.md",
      ".editorconfig": ".editorconfig",
      ".claude/settings.json": "claude/settings.json",
      ".github/workflows/release.yml": "workflows/release.yml",
      ".github/workflows/gates.yml": "workflows/gates.yml",
      "config/layout.kit.yml": "config/layout.kit.yml",
      "config/pyproject.schema.json": "config/pyproject.schema.json",
      "config/composer.schema.json": "config/composer.schema.json",
      "config/cargo.schema.json": "config/cargo.schema.json"
    },
    "comment": "K410-1: the owner rules that kit ships with its copies and with the hooks that make hooks writes; a consumer merges them into its owner checks (owner-check reads them from the installed package), and the test of tests/kit/kit-sync.test.mts fails a copy that no rule owns.",
    "owners": [
      {
        "paths": [
          ".github/workflows/release.yml",
          ".github/workflows/gates.yml",
          ".claude/settings.json",
          ".editorconfig"
        ],
        "targets": [
          "layout-check"
        ]
      },
      {
        "paths": [
          "PRINCIPLES.md"
        ],
        "targets": [
          "rules-check"
        ]
      },
      {
        "paths": [
          "PRINCIPLES.ko.md"
        ],
        "targets": [
          "docs-check"
        ]
      },
      {
        "paths": [
          "config/layout.kit.yml",
          "config/pyproject.schema.json",
          "config/composer.schema.json",
          "config/cargo.schema.json"
        ],
        "targets": [
          "layout-check",
          "kit-check"
        ]
      },
      {
        "paths": [
          "config/commit-identity.json"
        ],
        "targets": [
          "commits-check"
        ]
      },
      {
        "paths": [
          ".githooks/pre-commit",
          ".githooks/pre-merge-commit",
          ".githooks/pre-push",
          ".githooks/commit-msg",
          ".githooks/prepare-commit-msg",
          ".githooks/reference-transaction"
        ],
        "targets": [
          "hooks-check"
        ]
      }
    ]
  },
  "dependencies": {
    "@decimalturn/toml-patch": "3.3.1",
    "@mdit-vue/shared": "3.0.2",
    "@microsoft/api-extractor": "7.60.0",
    "@microsoft/api-extractor-model": "7.33.15",
    "@renovatebot/pep440": "6.0.0",
    "@types/cross-spawn": "6.0.6",
    "@types/picomatch": "4.0.3",
    "@types/semver": "7.8.0",
    "acorn": "8.19.0",
    "acorn-walk": "8.3.5",
    "ajv": "8.20.0",
    "amaro": "1.3.0",
    "cross-spawn": "7.0.6",
    "eslint-scope": "9.1.2",
    "github-slugger": "2.0.0",
    "jscpd": "5.4.2",
    "knip": "6.43.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-frontmatter": "2.0.1",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-to-string": "4.0.0",
    "micromark-extension-frontmatter": "2.0.0",
    "micromark-extension-gfm": "3.0.0",
    "oxc-parser": "0.156.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "picomatch": "4.0.7",
    "pip-requirements-js": "1.0.3",
    "semver": "7.8.5",
    "shell-quote": "1.12.0",
    "smol-toml": "1.9.1",
    "unist-util-visit": "5.2.0"
  },
  "peerDependencies": {
    "@playwright/test": "1.64.1",
    "@vscode/test-electron": "^3.1.0"
  },
  "peerDependenciesMeta": {
    "@vscode/test-electron": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    }
  }
}
