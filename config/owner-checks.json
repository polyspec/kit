{
  "schema": 1,
  "comment": "The owner checks of kit. A change under scripts/kit, tests/kit or the package files runs kit-test and typecheck, the whole tool suite of kit; the real tool tests of tests/source do not run for it and wait for the full run, since choosing them per module would need an import graph tool, which K111 withdrew. A changed tests/source test runs itself. consumer-layout and fresh-checkout run make kit-test again inside a sandbox, so they run only for themselves and their helper tests/source/checkout.mts. LICENSE is read by no check.",
  "owners": [
    { "paths": ["scripts/kit/**", "tests/kit/**", "package.json", "package-lock.json", "tsconfig.json", "Makefile"], "targets": ["kit-test", "typecheck"] },
    { "paths": ["tests/source/*.test.mts"], "tests": ["$path"] },
    { "paths": ["tests/source/checkout.mts"], "tests": ["tests/source/checkout.test.mts", "tests/source/consumer-layout.test.mts", "tests/source/fresh-checkout.test.mts"] },
    { "paths": ["docs/**", "*.md", "config/documents.json"], "targets": ["documents-check"] },
    { "paths": ["config/commits.json"], "targets": ["commits-check"] },
    { "paths": ["config/toolchain.json", ".node-version"], "targets": ["toolchain-check", "kit-test"] },
    { "paths": ["config/phpunit/**"], "targets": ["kit-test"] },
    { "paths": ["config/owner-checks.json"], "targets": ["owner-validate"] },
    { "paths": ["config/checklist.json", ".githooks/**"], "targets": ["documents-check", "hooks-check"], "tests": ["tests/source/checklist-real.test.mts"] },
    { "paths": ["config/layout.yml", "config/layout.kit.yml"], "targets": ["layout-check"], "tests": ["tests/source/layout-real.test.mts"] },
    { "paths": [".github/**", "workflows/**"], "tests": ["tests/source/ci-workflow.test.mts", "tests/source/release-workflow.test.mts"] },
    { "paths": [".gitignore"], "tests": ["tests/source/tracked-var.test.mts"] },
    { "paths": ["LICENSE"] }
  ]
}
