{
  "schema": 1,
  "comment": "The owner checks of kit. A changed module of scripts/kit or tests/kit runs typecheck, duplication-check and lint-ts, the TypeScript lint that kit gives its consumers (K142), and the tests of tests/kit that import it, directly or through other modules, as the import graph of owner-check finds them (K191); a file of scripts/kit or tests/kit that is no module, such as a schema, a fixture or kit.mk, runs the tests that import the modules that read it. kit-test, the whole tool suite, is CI's full run and no owner. The package files run the checks that read them. The real tool tests of tests/source do not run for a module and wait for the full run. A changed tests/source test runs itself. consumer-layout and fresh-checkout run make kit-test again inside a sandbox, so they run only for themselves and their helper tests/source/checkout.mts. LICENSE and .editorconfig, which an editor reads, are read by no check.",
  "ciExempt": [
    { "target": "hooks-check", "reason": "needs the local core.hooksPath that make install-hooks writes; a CI checkout has no hooks to check" }
  ],
  "owners": [
    { "paths": ["scripts/kit/**/*.mts", "tests/kit/*.mts"], "targets": ["typecheck", "duplication-check", "lint-ts"], "importers": ["tests/kit/*.test.mts"] },
    { "paths": ["scripts/kit/schema/**"], "targets": ["kit-check"], "importers": ["tests/kit/*.test.mts"], "modules": ["scripts/kit/schema-validate.mts"] },
    { "paths": ["scripts/kit/toolchain-pins.json"], "importers": ["tests/kit/*.test.mts"], "modules": ["scripts/kit/toolchain-pins.mts"] },
    { "paths": ["scripts/kit/symbols/**"], "importers": ["tests/kit/*.test.mts"], "modules": ["scripts/kit/install-symbols.mts"] },
    { "paths": ["scripts/kit/kit.mk", "scripts/kit/kit-bootstrap.mk"], "targets": ["owner-validate", "kit-check"], "importers": ["tests/kit/*.test.mts"], "modules": ["tests/kit/kit-tools.mts", "tests/kit/kit-mk.test.mts", "tests/kit/kit-bootstrap.test.mts", "tests/kit/install-mise.test.mts", "tests/kit/kit-sync.test.mts"] },
    { "paths": ["tests/kit/tool-records.json"], "importers": ["tests/kit/*.test.mts"], "modules": ["tests/kit/registry.mts", "tests/kit/record-tools.mts"] },
    { "paths": ["tests/kit/fixture/**"], "importers": ["tests/kit/*.test.mts"], "modules": ["tests/kit/checkout.mts", "tests/kit/gates-checkout.mts", "tests/kit/toolchain-checkout.mts", "tests/kit/checklist.test.mts", "tests/kit/kit-sync.test.mts", "tests/kit/python-lock-check.test.mts", "tests/kit/registry.test.mts", "tests/kit/release-tools.test.mts", "tests/kit/schema.test.mts", "tests/kit/stubs.test.mts"] },
    { "paths": ["scripts/kit/test-hooks.mts"], "tests": ["tests/source/package.test.mts"] },
    { "paths": ["tests/kit/record-fixture.mts"], "importers": ["tests/kit/*.test.mts"], "modules": ["tests/kit/checkout.mts", "tests/kit/registry.mts"] },
    { "paths": ["Makefile"], "targets": ["owner-validate", "kit-check"], "tests": ["tests/kit/kit-mk.test.mts"] },
    { "paths": ["package.json"], "targets": ["typecheck", "kit-check", "dependency-policy-check", "lint-ts"], "tests": ["tests/kit/kit-sync.test.mts", "tests/source/package.test.mts"] },
    { "paths": ["package-lock.json"], "targets": ["typecheck", "kit-check", "dependency-policy-check", "lint-ts"] },
    { "paths": ["tsconfig.json"], "targets": ["typecheck", "lint-ts"] },
    { "paths": ["tests/source/*.test.mts"], "targets": ["lint-ts"], "tests": ["$path"] },
    { "paths": ["tests/source/real-tools.mts"], "targets": ["lint-ts"], "tests": ["tests/source/layout-real.test.mts", "tests/source/lint-go-real.test.mts", "tests/source/lint-php-real.test.mts", "tests/source/lint-python-real.test.mts", "tests/source/parity-real.test.mts", "tests/source/govulncheck-packages-real.test.mts"] },
    { "paths": ["tests/source/checkout.mts"], "targets": ["lint-ts"], "tests": ["tests/source/checkout.test.mts", "tests/source/consumer-layout.test.mts", "tests/source/fresh-checkout.test.mts"] },
    { "paths": ["docs/**", "*.md", "config/documents.json"], "targets": ["documents-check"] },
    { "paths": ["config/commits.json"], "targets": ["commits-check"] },
    { "paths": ["config/rebuild.json", "docs/rebuild/**"], "targets": ["rebuild-check", "documents-check"] },
    { "paths": ["config/dependency-policy.json", "config/dependency-review.json"], "targets": ["dependency-policy-check"] },
    { "paths": ["config/toolchain.json", ".php-version", "rust-toolchain.toml", "mise.toml", "mise.lock", ".mise/**"], "targets": ["toolchain-check", "kit-test"] },
    { "paths": ["config/phpunit/**"], "targets": ["kit-test"] },
    { "paths": ["config/php-lint/**"], "targets": ["kit-test"], "tests": ["tests/source/lint-php-real.test.mts"] },
    { "paths": ["config/owner-checks.json"], "targets": ["owner-validate"] },
    { "paths": ["config/generated.json"], "tests": ["tests/kit/generated-files.test.mts"] },
    { "paths": ["config/checklist.json", ".githooks/**"], "targets": ["documents-check", "hooks-check"], "tests": ["tests/source/checklist-real.test.mts"] },
    { "paths": ["tsconfig.build.json"], "targets": ["typecheck"], "tests": ["tests/source/package.test.mts"] },
    { "paths": ["config/release.json", "tests/release-consumer/**"], "targets": ["kit-check", "release-coverage"], "tests": ["tests/kit/release-root.test.mts", "tests/source/consumer-layout.test.mts"] },
    { "paths": ["config/layout.yml", "config/layout.kit.yml", "config/pyproject.schema.json", "config/composer.schema.json", "config/cargo.schema.json"], "targets": ["layout-check"], "tests": ["tests/source/layout-real.test.mts"] },
    { "paths": ["ruff.toml"], "tests": ["tests/source/lint-python-real.test.mts"] },
    { "paths": ["phpcs.xml.dist", "phpstan.dist.neon"], "tests": ["tests/source/lint-php-real.test.mts"] },
    { "paths": [".golangci.yml"], "tests": ["tests/source/lint-go-real.test.mts"] },
    { "paths": [".oxlintrc.json", "knip.json", "config/knip-entries.json", "config/api-extractor.kit.json"], "targets": ["lint-ts"], "tests": ["tests/source/lint-ts-real.test.mts"] },
    { "paths": [".github/**", "workflows/**"], "tests": ["tests/source/ci-workflow.test.mts", "tests/source/release-workflow.test.mts"] },
    { "paths": ["workflows/release.yml"], "tests": ["tests/source/consumer-layout.test.mts"] },
    { "paths": [".gitignore"], "tests": ["tests/source/tracked-var.test.mts"] },
    { "paths": ["LICENSE", ".editorconfig"] }
  ]
}
