{
  "schema": 1,
  "comment": "The owner checks of kit. A change under scripts/kit, tests/kit or the package files runs kit-test and typecheck, the whole tool suite of kit; the real tool tests of tests/source do not run for it and wait for the full run, since choosing them per module would need an import graph tool, which K111 withdrew. A changed tests/source test runs itself. consumer-layout and fresh-checkout run make kit-test again inside a sandbox, so they run only for themselves and their helper tests/source/checkout.mts. LICENSE and .editorconfig, which an editor reads, are read by no check.",
  "owners": [
    { "paths": ["scripts/kit/**", "tests/kit/**", "package.json", "package-lock.json", "tsconfig.json", "Makefile"], "targets": ["kit-test", "typecheck", "duplication-check"] },
    { "paths": ["tests/source/*.test.mts"], "tests": ["$path"] },
    { "paths": ["tests/source/real-tools.mts"], "tests": ["tests/source/layout-real.test.mts", "tests/source/lint-go-real.test.mts", "tests/source/lint-php-real.test.mts", "tests/source/lint-python-real.test.mts", "tests/source/parity-real.test.mts", "tests/source/govulncheck-packages-real.test.mts"] },
    { "paths": ["tests/source/checkout.mts"], "tests": ["tests/source/checkout.test.mts", "tests/source/consumer-layout.test.mts", "tests/source/fresh-checkout.test.mts"] },
    { "paths": ["docs/**", "*.md", "config/documents.json"], "targets": ["documents-check"] },
    { "paths": ["config/commits.json"], "targets": ["commits-check"] },
    { "paths": ["config/rebuild.json", "docs/rebuild/**"], "targets": ["rebuild-check", "documents-check"] },
    { "paths": ["config/dependency-policy.json", "config/dependency-review.json"], "targets": ["dependency-policy-check"] },
    { "paths": ["config/toolchain.json", ".node-version", ".php-version", "rust-toolchain.toml", "mise.toml", "mise.lock", ".mise/**"], "targets": ["toolchain-check", "kit-test"] },
    { "paths": ["config/phpunit/**"], "targets": ["kit-test"] },
    { "paths": ["config/php-lint/**"], "targets": ["kit-test"], "tests": ["tests/source/lint-php-real.test.mts"] },
    { "paths": ["config/owner-checks.json"], "targets": ["owner-validate"] },
    { "paths": ["config/checklist.json", ".githooks/**"], "targets": ["documents-check", "hooks-check"], "tests": ["tests/source/checklist-real.test.mts"] },
    { "paths": ["tsconfig.build.json"], "targets": ["typecheck"], "tests": ["tests/source/package.test.mts"] },
    { "paths": ["config/release.json", "tests/release-consumer/**"], "targets": ["kit-check", "release-coverage"], "tests": ["tests/kit/release-root.test.mts", "tests/source/consumer-layout.test.mts"] },
    { "paths": ["config/layout.yml", "config/layout.kit.yml", "config/pyproject.schema.json", "config/composer.schema.json", "config/cargo.schema.json"], "targets": ["layout-check"], "tests": ["tests/source/layout-real.test.mts"] },
    { "paths": ["ruff.toml"], "tests": ["tests/source/lint-python-real.test.mts"] },
    { "paths": ["phpcs.xml.dist", "phpstan.dist.neon"], "tests": ["tests/source/lint-php-real.test.mts"] },
    { "paths": [".golangci.yml"], "tests": ["tests/source/lint-go-real.test.mts"] },
    { "paths": [".oxlintrc.json", "knip.json", "config/api-extractor.kit.json"], "tests": ["tests/source/lint-ts-real.test.mts"] },
    { "paths": [".github/**", "workflows/**"], "tests": ["tests/source/ci-workflow.test.mts", "tests/source/release-workflow.test.mts"] },
    { "paths": [".gitignore"], "tests": ["tests/source/tracked-var.test.mts"] },
    { "paths": ["LICENSE", ".editorconfig"] }
  ]
}
