{
  "schema": 1,
  "hooks": ["pre-push"],
  "trackers": [
    {
      "path": "docs/plans/execution-checklist.md",
      "translation": "docs/plans/execution-checklist.ko.md",
      "format": "table",
      "idPattern": "K[0-9]+(?:[.-][0-9]+)*",
      "states": ["[ ]", "[~]", "[o]", "[!]", "[-]"],
      "active": "[~]",
      "done": "[o]"
    },
    {
      "path": "docs/plans/common-standard/checklist.md",
      "translation": "docs/plans/common-standard/checklist.ko.md",
      "format": "table",
      "idPattern": "K[0-9]+(?:[.-][0-9]+)*",
      "states": ["[ ]", "[~]", "[o]", "[!]", "[-]"],
      "active": "[~]",
      "done": "[o]"
    }
  ]
}
